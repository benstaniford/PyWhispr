#!/bin/bash
# Create a new release: bump the patch version in the source files, commit,
# then tag and push (which triggers the GitHub Actions release workflow).

set -e

cd "$(git rev-parse --show-toplevel)"

# Refuse to release with uncommitted changes: the tag must point at a clean tree.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "error: working tree has uncommitted changes; commit or stash them first." >&2
  exit 1
fi

git fetch --tags

# Latest release tag (e.g. v1.2.3); default to v0.0.0 so the first bump is v0.0.1.
LATEST_TAG=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -n 1)
BASE_VERSION=${LATEST_TAG#v}
BASE_VERSION=${BASE_VERSION:-0.0.0}

IFS='.' read -r MAJOR MINOR PATCH <<< "$BASE_VERSION"
PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"
NEW_TAG="v${NEW_VERSION}"

echo "Latest tag:  ${LATEST_TAG:-(none)}"
echo "New version: $NEW_TAG"

# Bump the version in the two source-of-truth files (anchored to line start so
# dependency/requires-python versions are untouched).
perl -pi -e "s/^version = \".*\"/version = \"$NEW_VERSION\"/" pyproject.toml
perl -pi -e "s/^__version__ = \".*\"/__version__ = \"$NEW_VERSION\"/" src/pywhispr/__init__.py

git add pyproject.toml src/pywhispr/__init__.py
git commit -m "Release $NEW_TAG"
git push origin HEAD

git tag "$NEW_TAG"
git push origin "$NEW_TAG"

echo "Release $NEW_TAG committed, tagged, and pushed."
